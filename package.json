{
  "name": "pubctl",
  "version": "0.1.2",
  "type": "module",
  "description": "Zero-config Docker orchestrator for Ghost CMS",
  "license": "MIT",
  "author": "Rajdeep Singh",
  "homepage": "https://github.com/frontendweb3/pubctl#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/frontendweb3/pubctl.git"
  },
  "bugs": {
    "url": "https://github.com/frontendweb3/pubctl/issues"
  },
  "keywords": [
    "ghost",
    "ghost-cms",
    "docker",
    "traefik",
    "orchestrator",
    "cli",
    "devops",
    "self-hosted",
    "mysql",
    "s3",
    "deploy-ghost-cms",
    "deploy-ghost"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "bin": {
    "pubctl": "dist/index.js"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "rm -rf dist && tsc --noEmit && bun build src/index.ts --target=node --outfile=dist/index.js --minify --external cpu-features",
    "bundle": "bun build src/index.ts --target=node --outfile=dist/index.js --minify --external cpu-features",
    "dev": "bun run src/index.ts",
    "start": "node dist/index.js",
    "prepack": "pnpm run build",
    "test": "bun test test/*.test.mjs"
  },
  "files": [
    "dist/index.js",
    "README.md",
    "LICENSE"
  ],
  "devDependencies": {
    "@types/dockerode": "^3.3.29",
    "@types/node": "^20.0.0",
    "chalk": "^4.1.2",
    "dockerode": "^4.0.2",
    "mysql2": "^3.9.0",
    "ora": "^5.4.1",
    "typescript": "^5.4.0",
    "zod": "^4.6.7",
    "zodline": "^0.4.0"
  }
}
