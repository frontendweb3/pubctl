{
  "name": "pubctl",
  "version": "0.1.1",
  "description": "Zero-config Docker orchestrator for Ghost CMS",
  "license": "MIT",
  "author": "Rajdeep Singh",
  "homepage": "https://github.com/frontendweb3/pubctl#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/frontendweb3/pubctl.git"
  },
  "bugs": {
    "url": "https://github.com/frontendweb3/pubctl/issues"
  },
  "keywords": [
    "ghost",
    "ghost-cms",
    "docker",
    "traefik",
    "orchestrator",
    "cli",
    "devops",
    "self-hosted",
    "mysql",
    "s3"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "bin": {
    "pubctl": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "compile": "bun build --compile --minify --external cpu-features --outfile=dist/pubctl src/index.ts",
    "compile:linux-x64": "bun build --compile --target=bun-linux-x64 --minify --external cpu-features --outfile=dist/pubctl src/index.ts",
    "dev": "bun run src/index.ts",
    "start": "node dist/index.js",
    "pubctl": "./dist/pubctl",
    "run:bin": "./dist/pubctl",
    "prepack": "pnpm run build",
    "test": "pnpm run build && node --test test/*.test.mjs"
  },
  "files": [
    "dist",
    "!dist/pubctl*",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "chalk": "^4.1.2",
    "commander": "^12.0.0",
    "dockerode": "^4.0.2",
    "mysql2": "^3.9.0",
    "ora": "^5.4.1"
  },
  "devDependencies": {
    "@types/dockerode": "^3.3.29",
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0"
  }
}
